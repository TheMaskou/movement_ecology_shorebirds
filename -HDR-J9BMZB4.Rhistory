by = c("Band.ID", "recvDeployName", "runID")) %>%
mutate(duration = difftime(runEnd, runStart, units = "hours")) %>%
group_by(Band.ID, speciesEN, recvDeployName, tideCategory)  %>%
summarise(duration = sum(duration)) %>%
