# --- 2. Summarise counts by hour ---------------------------------------------
hourly_counts <- plot_data %>%
group_by(hour, direction_simple) %>%
summarise(n = n(), .groups = "drop") %>%
# Ensure both directions appear for every hour (fill missing with 0)
complete(hour, direction_simple, fill = list(n = 0))
# --- 2. Summarise counts by hour ---------------------------------------------
hourly_counts <- plot_data %>%
group_by(hour, direction) %>%
summarise(n = n(), .groups = "drop") %>%
# Ensure both directions appear for every hour (fill missing with 0)
complete(hour, direction_simple, fill = list(n = 0))
# --- 2. Summarise counts by hour ---------------------------------------------
hourly_counts <- plot_data %>%
group_by(hour, direction) %>%
summarise(n = n(), .groups = "drop") %>%
# Ensure both directions appear for every hour (fill missing with 0)
complete(hour, direction, fill = list(n = 0))
# --- 3. Calculate proportions for each hour ----------------------------------
hourly_props <- hourly_counts %>%
group_by(hour) %>%
mutate(
total = sum(n),
prop = n / total * 100  # as percentage
) %>%
ungroup()
# --- 4. Plot: stacked bars showing FROM vs TO for each hour ------------------
p <- ggplot(hourly_props, aes(x = factor(hour), y = prop, fill = direction_simple)) +
geom_col(position = "stack", colour = "black", linewidth = 0.3) +
# Add count labels inside each bar segment
geom_text(
aes(label = ifelse(n > 0, paste0(n, " (", round(prop, 0), "%)"), "")),
position = position_stack(vjust = 0.5),
size = 3,
colour = "white"
) +
scale_fill_manual(
name = "Direction",
values = c("FROM mudflat (rising tide)" = "firebrick",
"TO mudflat (falling tide)" = "steelblue"),
labels = c("FROM mudflat\n(rising tide)", "TO mudflat\n(falling tide)")
) +
labs(
x = "Hour of day",
y = "Percentage of flybys",
title = "Flyby Direction by Hour of Day",
subtitle = sprintf("n = %d validated flybys | Tide-rule accuracy = 54.5%%", nrow(plot_data))
) +
scale_y_continuous(breaks = seq(0, 100, by = 20), labels = paste0(seq(0, 100, by = 20), "%")) +
theme_minimal(base_size = 12) +
theme(
plot.title = element_text(face = "bold"),
legend.position = "top",
legend.text = element_text(size = 10),
panel.grid.minor = element_blank()
)
print(p)
